{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalLens",
  "version": "0.3.2",
  "identifier": "app.locallens.desktop",
  "build": {
    "frontendDist": "../startup"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "sidecar/locallens-backend/": "backend/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
